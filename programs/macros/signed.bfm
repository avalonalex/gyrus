* Numbers that can be below zero.
*
* A cell counts upwards from nothing and has nowhere to put a minus sign, so
* `lib/signed.bfm` uses two cells: a sign and a size. This program works the
* four cases addition has -- both positive, both negative, and the two ways of
* facing off -- on values whose answers can be read off the line.
*
* What it works out:
*
*     print(5 + 3, -5 + -3, 5 + -3, 3 + -5)
*     print(4 + -4)             # the one that made a negative zero
*     print(5 - 3, 3 - 5, -2 - 3, 0 - -7)
*
* Each answer is printed as a sign and a size: `-` or `+`, then a digit.

@include "lib/signed.bfm"

@var a_sign
@var a_size
@var b_sign
@var b_size
@var flag
@var scratch
@var spare
@var out

* A signed value, as the two things it is.
@macro show {
    @unless(a_sign, flag, scratch, spare) {
        @say(out, '+')
    }
    @when(a_sign, flag, scratch, spare) {
        @say(out, '-')
    }
    @show_digit(a_size)
    @say(out, SPACE)
}

@macro sum(as, am, bs, bm) {
    @signed_put(a_sign, a_size, as, am)
    @signed_put(b_sign, b_size, bs, bm)
    @signed_add(a_sign, a_size, b_sign, b_size)
    @show
}

@macro difference(as, am, bs, bm) {
    @signed_put(a_sign, a_size, as, am)
    @signed_put(b_sign, b_size, bs, bm)
    @signed_sub(a_sign, a_size, b_sign, b_size)
    @show
}

* Signs that agree, then signs that do not.
@sum(0, 5, 0, 3)
@sum(1, 5, 1, 3)
@sum(0, 5, 1, 3)
@sum(0, 3, 1, 5)

* The one that cancels, which is where a negative zero came from.
@sum(0, 4, 1, 4)

@difference(0, 5, 0, 3)
@difference(0, 3, 0, 5)
@difference(1, 2, 0, 3)
@difference(0, 0, 1, 7)
@newline(out)
