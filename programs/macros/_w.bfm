@include "lib/wide.bfm"
@var a_hi
@var a_lo
@var b_hi
@var b_lo
@var r
@var same
@var count
@var step
@var passed
@var flag
@var other
@var held
@var scratch
@var spare
@var out
@macro show(hi, lo) {
    @to hi
    .
    @to lo
    .
}
@wide_put(a_hi, a_lo, 1, 200)
@wide_put(b_hi, b_lo, 0, 100)
@wide_add(a_hi, a_lo, b_hi, b_lo, count, flag, held, spare)
@show(a_hi, a_lo)
@wide_put(a_hi, a_lo, 2, 10)
@wide_put(b_hi, b_lo, 0, 30)
@wide_sub(a_hi, a_lo, b_hi, b_lo, count, flag, held, spare)
@show(a_hi, a_lo)
@wide_put(a_hi, a_lo, 1, 5)
@wide_put(b_hi, b_lo, 1, 9)
@wide_less(a_hi, a_lo, b_hi, b_lo, r, same, count, step, passed, flag, other, scratch, spare)
@to r
.
@wide_put(a_hi, a_lo, 3, 5)
@wide_put(b_hi, b_lo, 1, 9)
@wide_less(a_hi, a_lo, b_hi, b_lo, r, same, count, step, passed, flag, other, scratch, spare)
@to r
.
